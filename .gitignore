# Node / React
node_modules/
dist/
*.tsbuildinfo
.vite/

# Flutter / Dart
.dart_tool/
.packages
build/
*.iml
.flutter-plugins
.flutter-plugins-dependencies
# pubspec.lock is intentionally committed: the cloud APK build must resolve the
# exact same plugin versions verified locally (e.g. shared_preferences_android
# 2.5.0). Letting it float broke the release build with a NoSuchMethodError.

# Generated native host projects (recreate with `flutter create .`)
flutter_app/android/
flutter_app/ios/
flutter_app/linux/
flutter_app/macos/
flutter_app/windows/
flutter_app/web/

# Arduino build output
firmware/**/build/
*.hex
*.elf

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Exports
*.csv

# Downloaded CI build artifacts (APK zips pulled from GitHub Actions)
_apk_out/
_apk_prof/

# MCP config holds the DESIGNmd API key - never commit
.kiro/settings/mcp.json
